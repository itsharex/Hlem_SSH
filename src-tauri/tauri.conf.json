{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "HelM",
  "version": "0.1.0",
  "identifier": "com.helm.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "url": "index.html",
        "title": "HelM",
        "width": 1365,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 720,
        "center": true,
        "resizable": true,
        "visible": false,
        "backgroundColor": "#f4f7fa"
      },
      {
        "label": "splash",
        "url": "splash.html",
        "title": "HelM",
        "width": 360,
        "height": 220,
        "center": true,
        "resizable": false,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "backgroundColor": "#f4f7fa"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.ico"]
  }
}
